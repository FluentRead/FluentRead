    "bidi-js": "1.1.0",
    "ai": "7.0.165",
    "crypto-js": "^4.2.0",
    "defuddle": "^0.19.6",
    "dexie": "^4.4.7",
    "element-plus": "^2.9.3",
    "entities": "4.5.0",
    "franc-min": "^6.2.0",
    "jszip": "3.10.1",
    "koroman": "1.0.16",
    "kuroshiro": "1.2.1",
    "mathml-to-latex": "1.8.0",
    "onnxruntime-web": "1.23.2",
    "pako": "2.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pinyin-pro": "3.29.4",
    "ppu-paddle-ocr": "6.6.0",
    "saxes": "6.0.0",
    "tesseract.js": "^7.0.0",
    "thai-rtgs": "0.1.3",
    "tldts": "^7.4.19",
    "turndown": "7.2.4",
    "webextension-polyfill": "^0.12.0",
    "x-fetch": "0.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gfx/zopfli": "1.0.15",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/vue3": "10.6.6",
    "@storybook/vue3-vite": "10.6.6",
    "@types/chrome": "^0.2.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.19.0",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.0.0",
    "linkedom": "0.18.12",
    "obsidian": "1.13.1",
    "storybook": "10.6.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-userscript": "npm:vite@5.4.21",
    "vitepress": "^1.6.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "3.3.13",
    "web-ext": "^10.8.0",
    "web-ext-run": "0.2.4",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
