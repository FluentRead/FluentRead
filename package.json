{
  "name": "FluentRead-流畅阅读",
  "description": "Read web pages in two languages, translate selected text, and choose from multiple translation services.",
  "private": true,
  "version": "0.0.41",
  "userscriptVersion": "2.0.2",
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "chatgpt:bridge": "node integrations/chatgpt-plan/cli.mjs",
    "test:chatgpt-bridge": "node --test tests/chatgptPlanBridge.test.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "node scripts/testing/run-resource-safe.mjs -- wxt build",
    "build:userscript": "node scripts/testing/run-resource-safe.mjs -- node node_modules/vite-userscript/bin/vite.js build --config userscript/vite.config.ts",
    "build:userscript:greasyfork": "node scripts/testing/run-resource-safe.mjs -- node scripts/build-userscript-greasyfork.mjs",
    "build:userscript:standalone": "node scripts/testing/run-resource-safe.mjs -- node scripts/build-userscript-standalone.mjs",
    "build:obsidian": "tsc -p integrations/obsidian/tsconfig.json --noEmit && vite build --config integrations/obsidian/vite.config.ts",
    "build:zotero": "vue-tsc -p integrations/zotero/tsconfig.json --noEmit && vite build --config integrations/zotero/vite.config.ts --mode native && vite build --config integrations/zotero/vite.config.ts --mode workspace && node integrations/zotero/package.mjs",
    "verify:zotero": "node integrations/zotero/package.mjs --verify",
    "test:zotero": "node scripts/testing/run-resource-safe.mjs -- vitest run --config vitest.zotero.config.ts",
    "generate:userscript-languages": "node scripts/generate-userscript-language-data.mjs",
    "verify:brand": "node scripts/verify-brand-copy.mjs",
    "verify:i18n": "node scripts/testing/run-resource-safe.mjs -- vitest run tests/i18n.test.ts tests/i18nMaterials.test.ts tests/i18nKeyReferences.test.ts tests/i18nRuntimeContracts.test.ts tests/i18nSettingsCopy.test.ts tests/i18nMetadata.test.ts tests/i18nContentUi.test.ts tests/uiLanguageBundles.test.ts tests/uiI18nOwnership.test.ts tests/uiI18nBundleLoading.test.ts tests/personalCorrectionUiPanel.test.ts tests/videoSentenceLearningComponent.test.ts tests/documentTranslationPresentation.test.ts tests/i18nPlural.test.ts tests/userscriptLanguageBundles.test.ts tests/userscriptMetadata.test.ts tests/vocabularyBookComponentLifecycle.test.ts tests/documentationToolContracts.test.ts tests/popupFeatureVisibility.test.ts tests/serviceDirectoryLifecycle.test.ts tests/settingsSectionsLifecycle.test.ts",
    "build:firefox": "node scripts/testing/run-resource-safe.mjs -- wxt build -b firefox",
    "build-for-amo": "npm run build:firefox && node scripts/amo/prepare-review-output.mjs",
    "lint:firefox:amo": "node scripts/testing/lint-firefox-amo.mjs",
    "build:safari": "node scripts/testing/run-resource-safe.mjs -- wxt build -b safari --mv2",
    "safari:check": "node scripts/safari/package.mjs --check",
    "safari:verify": "node scripts/safari/package.mjs --verify",
    "safari:package": "node scripts/safari/package.mjs",
    "build:thunderbird": "pnpm build:firefox && node scripts/thunderbird/package.mjs",
    "zip": "node scripts/testing/run-resource-safe.mjs -- wxt zip",
    "zip:edge": "node scripts/testing/run-resource-safe.mjs -- wxt zip -b edge && node scripts/release/verify-edge.mjs",
    "zip:firefox": "node scripts/testing/run-resource-safe.mjs -- wxt zip -b firefox",
    "compile": "node scripts/testing/verify-pinned-userscript-languages.mjs && node scripts/testing/run-typecheck.mjs",
    "test": "node scripts/testing/run-resource-safe.mjs -- vitest run",
    "test:audit": "node scripts/testing/audit-test-suite.mjs",
    "test:agent-bridge": "node --test tests/agentBridge.test.mjs",
    "test:architecture": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs architecture",
    "test:unit": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs unit",
    "test:functional": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs functional",
    "test:regression": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs regression",
    "test:coverage": "node scripts/testing/run-resource-safe.mjs -- vitest run --config vitest.coverage.config.ts",
    "test:regression:all": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-full-regression.mjs",
    "verify:extension-manifests": "node scripts/testing/verify-extension-manifests.mjs",
    "test:document": "node scripts/testing/run-resource-safe.mjs -- vitest run tests/documentArchive.test.ts tests/documentTranslation.test.ts tests/documentTranslationApi.test.ts tests/documentTranslationBinary.test.ts tests/documentTranslationBinaryEdge.test.ts tests/documentTranslationEdge.test.ts tests/documentTranslationExamplesApi.test.ts tests/documentTranslationPresentation.test.ts tests/documentTranslationRegression.test.ts tests/translationDocumentCorpus.test.ts",
    "test:translation-core": "node scripts/testing/run-resource-safe.mjs -- vitest run tests/translationCore.test.ts tests/translationState.test.ts tests/serializationPerformance.test.ts tests/translateApiPerformance.test.ts tests/translateQueue.test.ts tests/pageContext.test.ts tests/pageContextDefuddle.test.ts",
    "test:selection-triggers": "node scripts/testing/run-resource-safe.mjs -- node scripts/run-selection-trigger-test.cjs",
    "test:pdf-selection": "node scripts/testing/run-resource-safe.mjs -- node scripts/run-pdf-selection-test.cjs",
    "test:translation-sites": "node scripts/testing/run-resource-safe.mjs -- node scripts/run-site-translation-matrix.cjs",
    "test:video:learning": "node scripts/testing/run-resource-safe.mjs -- vitest run --config vitest.video-learning.config.ts",
    "test:video:fixture": "node scripts/testing/run-resource-safe.mjs -- node scripts/run-video-subtitle-fixture-test.cjs",
    "test:video:x-fixture": "node scripts/testing/run-resource-safe.mjs -- node scripts/run-x-subtitle-sync-test.cjs",
    "test:video:reading": "node scripts/testing/run-resource-safe.mjs -- node scripts/run-video-reading-test.cjs",
    "test:watch": "node scripts/testing/run-resource-safe.mjs -- vitest",
    "test:userscript": "node scripts/testing/run-resource-safe.mjs -- pnpm build:userscript && node scripts/verify-userscript-build.mjs",
    "test:userscript:standalone": "pnpm build:userscript:standalone && node scripts/verify-userscript-standalone-build.mjs",
    "test:userscript:manager": "node scripts/run-userscript-manager-smoke-test.cjs",
    "postinstall": "wxt prepare",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/testing/run-resource-safe.mjs -- vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "node scripts/verify-docs-build.mjs",
    "docs:typecheck": "vue-tsc --noEmit -p docs/tsconfig.json",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "storybook:build": "node scripts/testing/run-resource-safe.mjs -- storybook build --output-dir docs/.vitepress/dist/storybook --disable-telemetry",
    "storybook:typecheck": "vue-tsc --noEmit -p storybook/tsconfig.json",
    "storybook:check": "node scripts/verify-storybook-build.mjs",
    "docs:build:site": "pnpm docs:build && pnpm storybook:build",
    "docs:contributors": "node scripts/update-readme-contributors.mjs",
    "analyze:bundle": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/analyze-bundle-size.mjs",
    "test:cloud-backup": "node scripts/testing/run-resource-safe.mjs -- vitest run --config vitest.cloud-backup.config.ts"
  },
  "dependencies": {
