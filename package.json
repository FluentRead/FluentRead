{
  "name": "FluentRead-流畅阅读",
  "description": "An open-source browser extension for bilingual reading and translation. 一款开源的双语阅读与翻译浏览器插件。",
  "private": true,
  "version": "0.0.32",
  "userscriptVersion": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:userscript": "vite build --config userscript/vite.config.ts",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:audit": "node scripts/testing/audit-test-suite.mjs",
    "test:architecture": "node scripts/testing/run-test-group.mjs architecture",
    "test:unit": "node scripts/testing/run-test-group.mjs unit",
    "test:functional": "node scripts/testing/run-test-group.mjs functional",
    "test:regression": "node scripts/testing/run-test-group.mjs regression",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "test:regression:all": "node scripts/testing/run-full-regression.mjs",
    "verify:extension-manifests": "node scripts/testing/verify-extension-manifests.mjs",
    "test:document": "vitest run tests/documentTranslation.test.ts tests/documentTranslationApi.test.ts tests/documentTranslationBinary.test.ts tests/documentTranslationBinaryEdge.test.ts tests/documentTranslationEdge.test.ts tests/documentTranslationExamplesApi.test.ts tests/documentTranslationPresentation.test.ts tests/documentTranslationRegression.test.ts tests/translationDocumentCorpus.test.ts",
    "test:translation-core": "vitest run tests/translationCore.test.ts tests/translationState.test.ts tests/serializationPerformance.test.ts tests/translateApiPerformance.test.ts tests/translateQueue.test.ts tests/pageContext.test.ts tests/pageContextDefuddle.test.ts",
    "test:selection-triggers": "node scripts/run-selection-trigger-test.cjs",
    "test:translation-sites": "node scripts/run-site-translation-matrix.cjs",
    "test:video:fixture": "node scripts/run-video-subtitle-fixture-test.cjs",
    "test:video:x-fixture": "node scripts/run-x-subtitle-sync-test.cjs",
    "test:watch": "vitest",
    "test:userscript": "pnpm build:userscript && node scripts/verify-userscript-build.mjs",
    "postinstall": "wxt prepare",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "analyze:bundle": "node scripts/testing/analyze-bundle-size.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.116",
    "@ai-sdk/google": "3.0.121",
    "@ai-sdk/openai-compatible": "2.0.70",
    "@element-plus/icons-vue": "^2.3.1",
    "@huggingface/transformers": "3.8.1",
    "@wxt-dev/storage": "^1.0.1",
    "ai": "6.0.264",
    "crypto-js": "^4.2.0",
    "defuddle": "^0.19.2",
    "dexie": "^4.4.4",
    "element-plus": "^2.9.3",
    "franc-min": "^6.2.0",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "^6.0.1",
    "tldts": "^7.4.10",
    "webextension-polyfill": "^0.12.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.0",
    "@types/crypto-js": "^4.2.2",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "2.1.9",
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "fake-indexeddb": "^6.0.0",
    "linkedom": "0.18.12",
    "typescript": "^5.7.3",
    "vite": "^5.4.19",
    "vite-plugin-imagemin": "^0.6.1",
    "vitepress": "^1.6.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0",
    "wxt": "^0.20.18"
  },
  "pnpm": {
    "overrides": {
      "vite": "5.4.19"
    }
  },
  "packageManager": "pnpm@9.12.1+sha1.7084e7df42ee1d221994c2c2599277a2a937f050"
}
