{
  "name": "FluentRead-流畅阅读",
  "description": "Closer languages. A bigger world. 让语言更近，让世界更大。",
  "private": true,
  "version": "0.0.35",
  "userscriptVersion": "2.0.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "node scripts/testing/run-resource-safe.mjs -- wxt build",
    "build:userscript": "node scripts/testing/run-resource-safe.mjs -- vite build --config userscript/vite.config.ts",
    "build:userscript:greasyfork": "node scripts/testing/run-resource-safe.mjs -- node scripts/build-userscript-greasyfork.mjs",
    "build:userscript:standalone": "node scripts/testing/run-resource-safe.mjs -- node scripts/build-userscript-standalone.mjs",
    "build:obsidian": "tsc -p integrations/obsidian/tsconfig.json --noEmit && vite build --config integrations/obsidian/vite.config.ts",
    "generate:userscript-languages": "node scripts/generate-userscript-language-data.mjs",
    "verify:brand": "node scripts/verify-brand-copy.mjs",
    "build:firefox": "node scripts/testing/run-resource-safe.mjs -- wxt build -b firefox",
    "build:thunderbird": "pnpm build:firefox && node scripts/thunderbird/package.mjs",
    "zip": "node scripts/testing/run-resource-safe.mjs -- wxt zip",
    "zip:firefox": "node scripts/testing/run-resource-safe.mjs -- wxt zip -b firefox",
    "compile": "node scripts/testing/run-resource-safe.mjs -- vue-tsc --noEmit",
    "test": "node scripts/testing/run-resource-safe.mjs -- vitest run",
    "test:audit": "node scripts/testing/audit-test-suite.mjs",
    "test:agent-bridge": "node --test tests/agentBridge.test.mjs",
    "test:architecture": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs architecture",
    "test:unit": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs unit",
    "test:functional": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs functional",
    "test:regression": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs regression",
    "test:coverage": "node scripts/testing/run-resource-safe.mjs -- vitest run --config vitest.coverage.config.ts",
    "test:regression:all": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-full-regression.mjs",
    "verify:extension-manifests": "node scripts/testing/verify-extension-manifests.mjs",
    "test:document": "node scripts/testing/run-resource-safe.mjs -- vitest run tests/documentTranslation.test.ts tests/documentTranslationApi.test.ts tests/documentTranslationBinary.test.ts tests/documentTranslationBinaryEdge.test.ts tests/documentTranslationEdge.test.ts tests/documentTranslationExamplesApi.test.ts tests/documentTranslationPresentation.test.ts tests/documentTranslationRegression.test.ts tests/translationDocumentCorpus.test.ts",
    "test:translation-core": "node scripts/testing/run-resource-safe.mjs -- vitest run tests/translationCore.test.ts tests/translationState.test.ts tests/serializationPerformance.test.ts tests/translateApiPerformance.test.ts tests/translateQueue.test.ts tests/pageContext.test.ts tests/pageContextDefuddle.test.ts",
    "test:selection-triggers": "node scripts/testing/run-resource-safe.mjs -- node scripts/run-selection-trigger-test.cjs",
    "test:translation-sites": "node scripts/testing/run-resource-safe.mjs -- node scripts/run-site-translation-matrix.cjs",
    "test:video:fixture": "node scripts/testing/run-resource-safe.mjs -- node scripts/run-video-subtitle-fixture-test.cjs",
    "test:video:x-fixture": "node scripts/testing/run-resource-safe.mjs -- node scripts/run-x-subtitle-sync-test.cjs",
    "test:watch": "node scripts/testing/run-resource-safe.mjs -- vitest",
    "test:userscript": "node scripts/testing/run-resource-safe.mjs -- pnpm build:userscript && node scripts/verify-userscript-build.mjs",
    "test:userscript:standalone": "pnpm build:userscript:standalone && node scripts/verify-userscript-standalone-build.mjs",
    "test:userscript:manager": "node scripts/run-userscript-manager-smoke-test.cjs",
    "postinstall": "wxt prepare",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/testing/run-resource-safe.mjs -- vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "node scripts/verify-docs-build.mjs",
    "docs:typecheck": "vue-tsc --noEmit -p docs/tsconfig.json",
    "docs:contributors": "node scripts/update-readme-contributors.mjs",
    "analyze:bundle": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/analyze-bundle-size.mjs",
    "test:cloud-backup": "node scripts/testing/run-resource-safe.mjs -- vitest run --config vitest.cloud-backup.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.116",
    "@ai-sdk/google": "3.0.121",
    "@ai-sdk/openai-compatible": "2.0.70",
    "@ctrl/tinycolor": "3.6.1",
    "@element-plus/icons-vue": "^2.3.1",
    "@huggingface/transformers": "3.8.1",
    "@huggingface/transformers-kokoro": "npm:@huggingface/transformers@4.2.0",
    "@noble/hashes": "1.8.0",
    "@uzen/kokoro-js": "1.2.4",
    "@wllama/wllama": "3.6.1",
    "@wxt-dev/storage": "^1.0.1",
    "ai": "6.0.264",
    "crypto-js": "^4.2.0",
    "defuddle": "^0.19.2",
    "dexie": "^4.4.4",
    "element-plus": "^2.9.3",
    "franc-min": "^6.2.0",
    "jszip": "3.10.1",
    "pako": "2.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "^6.0.1",
    "tldts": "^7.4.10",
    "webextension-polyfill": "^0.12.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "22.10.7",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "2.1.9",
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "fake-indexeddb": "^6.0.0",
    "linkedom": "0.18.12",
    "obsidian": "1.13.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.19",
    "vite-plugin-imagemin": "^0.6.1",
    "vitepress": "^1.6.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0",
    "wxt": "^0.20.18"
  },
  "pnpm": {
    "overrides": {
      "vite": "5.4.19"
    }
  },
  "packageManager": "pnpm@9.12.1+sha1.7084e7df42ee1d221994c2c2599277a2a937f050"
}
