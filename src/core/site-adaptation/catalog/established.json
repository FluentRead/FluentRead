[
  {
    "id": "kagi-news",
    "name": "Kagi News 新闻标题",
    "match": {
      "hosts": ["news.kagi.com"]
    },
    "allScopes": true,
    "mode": "augment",
    "content": [
      {
        "css": [
          "button[aria-label=\"Expand story\"] > span[dir]",
          "button[aria-label=\"Collapse story\"] > span[dir]"
        ],
        "resolve": "closest",
        "key": "kagi-news:headline"
      },
      {
        "css": [
          "button[aria-label=\"Expand story\"]",
          "button[aria-label=\"Collapse story\"]"
        ],
        "atomic": false,
        "key": "kagi-news:headline-button"
      }
    ]
  },
  {
    "id": "openrouter",
    "name": "OpenRouter",
    "allScopes": true,
    "match": {
      "hosts": [
        "openrouter.ai"
      ]
    },
    "priority": 380,
    "mode": "augment",
    "omit": [
      "li a[href^=\"/\"][href*=\"/\"] > span.font-semibold",
      "#model-title-row h1",
      "#model-title-row h3[title=\"Model identifier for use in the API\"]"
    ]
  },
  {
    "id": "discord-server-rail",
    "name": "Discord 服务器图标栏",
    "allScopes": true,
    "match": {
      "hosts": [
        "discord.com",
        "canary.discord.com",
        "ptb.discord.com"
      ],
      "paths": [
        "/channels/*"
      ]
    },
    "mode": "augment",
    "exclude": [
      "[data-list-id=\"guildsnav\"]",
      "nav[aria-label=\"Servers sidebar\"]"
    ]
  },
  {
    "id": "bilibili",
    "name": "哔哩哔哩",
