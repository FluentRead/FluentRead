  {
    "id": "x",
    "name": "X / Twitter",
    "match": {
      "hosts": [
        "*.x.com",
        "*.twitter.com"
      ]
    },
    "priority": 400,
    "mode": "augment",
    "content": [
      {
        "css": [
          "[data-testid=\"tweetText\"]"
        ],
        "key": "x-post-text",
        "resolve": "closest"
      },
      {
        "css": [
          "[data-testid=\"UserDescription\"]",
          "aside section > div > div > div > div.items-center.justify-between + div.line-clamp-4:not([role])"
        ],
        "key": "x-user-description",
        "resolve": "closest"
      },
      {
        "css": [
          "[data-testid=\"twitterArticleReadView\"] p"
        ],
        "key": "x-article-prose",
        "resolve": "closest"
      }
    ],
    "protect": [
      "time",
      "[role=\"progressbar\"]",
      "[data-testid=\"app-bar-back\"]",
      "main article span:has(+ span > a.x-link[href^=\"/\"]:not([href^=\"//\"]) > span.text-secondary.line-clamp-1) > a.x-link[href^=\"/\"]:not([href^=\"//\"]) > div.text-body.font-bold.line-clamp-1:not([dir=\"auto\"] *)"
    ],
    "exclude": [
      "[data-testid=\"tweetTextarea_0\"]",
      "[data-testid=\"DMComposerTextInput\"]",
      "[data-testid=\"User-Name\"]",
      "[data-testid=\"UserName\"]",
      "main article div:has(> video) > [data-slot=\"xds-context-menu-trigger\"] span:has(> span > .x-avatar > img[alt^=\"@\"]) > div > span > div.text-white.line-clamp-1:not([dir=\"auto\"]):not([dir=\"auto\"] *)",
      "main article div:has(> [data-engagement-action=\"reply\"]):has(> [data-engagement-action=\"retweet\"]):has(> [data-engagement-action=\"like\"])"
    ],
    "watchIgnore": [
      "main article span:has(+ span > a.x-link[href^=\"/\"]:not([href^=\"//\"]) > span.text-secondary.line-clamp-1) > a.x-link[href^=\"/\"]:not([href^=\"//\"]) > div.text-body.font-bold.line-clamp-1:not([dir=\"auto\"] *)"
    ]
  },
